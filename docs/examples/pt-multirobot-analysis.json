{
  "kind": "sopilot-system-analysis",
  "report_version": 1,
  "system": {
    "name": "PolarTie MultiRobot",
    "description": "PolarTie real-time voice-agent platform: a robot config.json drives an OpenAI-realtime voice agent with tools, MCP servers, knowledge bases and transfer topics. Master orchestrator + generator server + notification service; supervisor via MCP.",
    "analyzed_at": "2026-07-26T00:00:00Z",
    "sources": [
      "defaults.json",
      "sample_config",
      "code"
    ]
  },
  "components": [
    {
      "id": "voice_agent",
      "name": "Voice Agent",
      "kind": "service",
      "description": "per-call OpenAI-realtime agent (gpt_voice_assistant)",
      "depends_on": [
        "master",
        "generator_server",
        "notification_service",
        "kb_backend"
      ],
      "exposes": [
        {
          "kind": "webrtc",
          "path": "realtime",
          "methods": [
            "SDP"
          ]
        },
        {
          "kind": "mcp-client",
          "path": "/mcp",
          "methods": [
            "tool-call"
          ]
        }
      ]
    },
    {
      "id": "master",
      "name": "Master orchestrator",
      "kind": "service",
      "description": "session lifecycle + routing (master.py)",
      "depends_on": [
        "voice_agent"
      ]
    },
    {
      "id": "generator_server",
      "name": "Generator Server",
      "kind": "external",
      "description": "mints realtime client tokens / SDP",
      "depends_on": []
    },
    {
      "id": "notification_service",
      "name": "Notification Service",
      "kind": "external",
      "description": "email/SMS delivery",
      "depends_on": []
    },
    {
      "id": "kb_backend",
      "name": "Knowledge backends",
      "kind": "datastore",
      "description": "OpenSearch (simple) or LightRAG/Context Graph (postgres)"
    },
    {
      "id": "supervisor_mcp",
      "name": "Supervisor MCP",
      "kind": "external",
      "description": "SOPilot supervisor surface (polartie_ai_agent_supervisor)"
    }
  ],
