  "integration_points": [
    {
      "name": "notification",
      "kind": "http",
      "direction": "outbound",
      "technology": {
        "protocol": "http",
        "method": "POST"
      },
      "target": {
        "url_field": "notification_service_url"
      },
      "auth": {
        "secret_ref": "notification_token",
        "header": "Authorization"
      },
      "description": "email/SMS send + verification",
      "component": "notification_service",
      "status": "known",
      "source": "code"
    },
    {
      "name": "opensearch",
      "kind": "http",
      "direction": "outbound",
      "technology": {
        "protocol": "http"
      },
      "target": {
        "url_field": "opensearch_endpoint"
      },
      "auth": {
        "secret_ref": "opensearch_key"
      },
      "description": "simple KB queries",
      "component": "kb_backend",
      "status": "known",
      "source": "code"
    },
    {
      "name": "lightrag_pg",
      "kind": "db",
      "direction": "outbound",
      "technology": {
        "dialect": "postgresql",
        "driver": "asyncpg",
        "protocol": "python"
      },
      "target": {
        "host_field": "lightrag.postgres.host",
        "port": 5432
      },
      "auth": {
        "secret_ref": "lightrag_dsn"
      },
      "description": "LightRAG knowledge base store",
      "component": "kb_backend",
      "status": "known",
      "source": "config.ini"
    },
    {
      "name": "realtime_llm",
      "kind": "http",
      "direction": "outbound",
      "technology": {
        "protocol": "webrtc",
        "api": "openai-realtime"
      },
      "target": {
        "url_field": "generator_server_url"
      },
      "auth": {
        "secret_ref": "openai_api_key",
        "header": "Authorization"
      },
      "description": "OpenAI realtime speech model (token via generator server)",
      "component": "generator_server",
      "status": "known",
      "source": "code"
    },
    {
      "name": "supervisor",
      "kind": "mcp",
      "direction": "outbound",
      "technology": {
        "protocol": "http",
        "transport": "streamable-http"
      },
      "target": {
        "url_field": "mcp_servers[].url"
      },
      "auth": {
        "secret_ref": "supervisor_token",
        "header": "Authorization"
      },
      "description": "SOPilot MCP supervisor (per-turn steering)",
      "component": "supervisor_mcp",
      "status": "known",
      "source": "code"
    }
  ],
